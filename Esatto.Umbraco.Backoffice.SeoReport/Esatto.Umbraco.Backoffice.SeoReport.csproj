<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- Serve wwwroot/App_Plugins/... at that literal path in the consumer. Default Razor SDK behaviour
         would prefix it with /_content/<PackageId>/, which Umbraco's package discovery does not look at. -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>

    <RootNamespace>Esatto.Umbraco.Backoffice.SeoReport</RootNamespace>
    <AssemblyName>Esatto.Umbraco.Backoffice.SeoReport</AssemblyName>

    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>Esatto.Umbraco.Backoffice.SeoReport</PackageId>
    <Authors>Carl Schéle</Authors>
    <Description>SEO Report for Umbraco: a Content-section dashboard that turns Google Analytics 4 and Google Search Console into a monthly SEO report. It archives each month's traffic, search visibility, top pages and queries, compares them with the previous month and the same month last year, follows targets and notes, and explains what changed in plain English. Connect it with a Google service account; the key is stored encrypted.</Description>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-18;backoffice;seo;google-analytics;search-console;ga4;report</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/carl-schele-esatto/Esatto.Packages/tree/main/Esatto.Umbraco.Backoffice.SeoReport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/carl-schele-esatto/Esatto.Packages</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <!-- The MIT notices of the code bundled into chart-bundle.js. Client/public holds an identical copy, so the notices also
         sit next to the redistributed script under App_Plugins (ScaffoldTests keeps the two the same). -->
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Api.Management: controller base + versioned route, and the Umbraco dependency the Marketplace
         detects. Web.Common: authorization policies. Min versions; resolve to the consumer's. -->
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="18.0.0" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="18.0.0" />
    <!-- Google Analytics 4 (Data API runReport) and Search Console (searchanalytics.query). -->
    <PackageReference Include="Google.Apis.AnalyticsData.v1beta" Version="1.78.0.4296" />
    <PackageReference Include="Google.Apis.SearchConsole.v1" Version="1.75.0.4234" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Esatto.Umbraco.Backoffice.SeoReport.Tests" />
  </ItemGroup>

  <ItemGroup Label="Security overrides">
    <!-- Patched floors for advisories that Umbraco's transitive graph pulls in; same pins and reasons as
         the Accessibility package. Drop each once Umbraco bumps its own dependency past it. -->
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="MimeKit" Version="4.16.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the client source as part of the nuget/static-web-assets build -->
    <Content Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <!-- Build the backoffice client (npm run build) into wwwroot BEFORE the static web assets are discovered, and list the
       wwwroot files again afterwards: the wwwroot glob is expanded when the project loads, before npm has run. That way the
       package holds exactly the files this build wrote, and the static-web-asset manifest packed with them (size, integrity)
       describes those files, not the previous build's; a file the build creates for the first time (a fresh clone has no
       wwwroot) is packed too. Skipped during IDE design-time builds, when there's no client (yet), and with
       -p:SkipClientBuild=true (then the wwwroot already on disk is used as it is). The lockfile decides what npm installs. -->
  <Target Name="BuildBackofficeClient" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(SkipClientBuild)' != 'true' And '$(DesignTimeBuild)' != 'true' And '$(BuildingProject)' == 'true' And Exists('$(MSBuildProjectDirectory)\Client\package.json')">
    <Message Importance="high" Text="Installing client dependencies (npm ci)..." Condition="!Exists('$(MSBuildProjectDirectory)\Client\node_modules')" />
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)\Client" Condition="!Exists('$(MSBuildProjectDirectory)\Client\node_modules')" />
    <Message Importance="high" Text="Building client (npm run build)..." />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\Client" />
    <PropertyGroup>
      <!-- The wwwroot folder with the separators of this platform and a closing one, so the prefix test below matches the
           FullPath of an item on Windows (\) and on Linux and macOS (/) alike. -->
      <_ClientWwwroot>$([MSBuild]::EnsureTrailingSlash('$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'wwwroot'))'))</_ClientWwwroot>
    </PropertyGroup>
    <ItemGroup>
      <!-- Drop what the load-time glob found (by path: a glob here would only match files that still exist, and the build may
           have deleted some), then the same item the SDK defines for wwwroot, expanded now that the build has written the files. -->
      <_ClientBuildStaleContent Include="@(Content)" Condition="$([System.String]::Copy('%(Content.FullPath)').StartsWith('$(_ClientWwwroot)', System.StringComparison.OrdinalIgnoreCase))" />
      <Content Remove="@(_ClientBuildStaleContent)" />
      <Content Include="wwwroot\**" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    </ItemGroup>
  </Target>

  <!-- With -p:SkipClientBuild=true the wwwroot already on disk is packed as it is. A fresh clone has none (it is built, not
       committed), and a package without the dashboard would pack without a word and only show its fault in a site. -->
  <Target Name="RequireBuiltClientToPack" BeforeTargets="GenerateNuspec;_GetPackageFiles" Condition="'$(SkipClientBuild)' == 'true'">
    <Error Code="SEOREPORT001"
           Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\App_Plugins\$(PackageId)\umbraco-package.json') Or !Exists('$(MSBuildProjectDirectory)\wwwroot\App_Plugins\$(PackageId)\seo-report-dashboard.js')"
           Text="SkipClientBuild=true, but wwwroot\App_Plugins\$(PackageId) holds no built dashboard (umbraco-package.json, seo-report-dashboard.js). Build the client first (dotnet build without SkipClientBuild, or npm run build in Client) or leave SkipClientBuild out; the package would contain no dashboard." />
  </Target>

  <PropertyGroup Label="AutoPush">
    <!-- Off by default so a local `dotnet pack` never publishes. -->
    <AutoPushToFeed Condition="'$(AutoPushToFeed)' == ''">false</AutoPushToFeed>
    <AutoPushFeedName Condition="'$(AutoPushFeedName)' == ''">esatto-packages</AutoPushFeedName>
  </PropertyGroup>

  <Target Name="AutoPushAfterPack" AfterTargets="Pack" Condition="'$(AutoPushToFeed)' == 'true'">
    <Message Importance="high" Text="Auto-pushing $(PackageId) $(PackageVersion) to '$(AutoPushFeedName)'..." />
    <Exec Command="dotnet nuget push &quot;$([MSBuild]::EnsureTrailingSlash('$(PackageOutputPath)'))$(PackageId).$(PackageVersion).nupkg&quot; --source $(AutoPushFeedName) --api-key az --skip-duplicate" />
  </Target>

  <ItemGroup Label="NuGet audit: SixLabors.ImageSharp">
    <!-- Umbraco 18 ships SixLabors.ImageSharp 3.x; these advisories are fixed only in 4.1.2. This package
         doesn't use ImageSharp, and the site's own Umbraco reports them there. Drop once Umbraco moves on. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>

</Project>
