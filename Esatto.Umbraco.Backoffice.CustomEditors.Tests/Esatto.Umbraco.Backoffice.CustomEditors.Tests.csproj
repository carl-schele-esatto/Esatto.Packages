<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Test-only project (not shipped). Targets an installed runtime; the package under test
         stays net8.0. A net10 test host references the net8 package fine. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!-- Gives the test access to ASP.NET Core Data Protection (EphemeralDataProtectionProvider). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Esatto.Umbraco.Backoffice.CustomEditors\Esatto.Umbraco.Backoffice.CustomEditors.csproj" />
  </ItemGroup>

  <!-- The shipped CustomEditors package is deliberately min-only (Umbraco >=14.0.0). Restored
       standalone it would drag in Umbraco 14's now-vulnerable transitive deps (MessagePack 2.5.x,
       Lucene.Net.Replicator, MimeKit 4.6.0). Pin the Umbraco graph here to 17 so the local test
       build resolves the same patched versions a modern consumer gets. Test-only; does not affect
       the package's min-only contract. -->
  <ItemGroup Label="Test-only: resolve Umbraco 17 patched graph">
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="17.0.0" />
    <!-- Umbraco 17's HybridCache still brings MessagePack 3.1.4 (GHSA-hv8m-jj95-wg3x); floor to 3.1.7. -->
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <!-- Same transitive graph, moderate/high advisories (NU1902/NU1903):
         - MailKit 4.14.0: STARTTLS response injection (GHSA-9j88-vvj5-vhgr), fixed 4.16.0.
         - MimeKit 4.14.0: CRLF injection in quoted local-part (GHSA-g7hc-96xr-gvvx), fixed 4.15.1;
           pinned to 4.16.0 because that is MailKit 4.16.0's own MimeKit floor.
         - System.Security.Cryptography.Pkcs 8.0.1/10.0.0: DoS, CVE-2026-84008 (GHSA-846f-f764-76mx);
           pinned to 10.0.13 because MimeKit 4.16.0 already needs 10.0.0 on net10.0. -->
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="MimeKit" Version="4.16.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
