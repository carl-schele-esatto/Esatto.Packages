{
  "$schema": "../umbraco-package-schema.json",
  "id": "Esatto.Umbraco.Backoffice.Build",
  "name": "Esatto Umbraco Backoffice Build",
  "version": "1.0.0",
  "allowTelemetry": false,
  "extensions": [
    {
      "type": "localization",
      "alias": "Esatto.Umbraco.Backoffice.Build.Localization.En",
      "name": "Build (English)",
      "meta": { "culture": "en" },
      "js": "/App_Plugins/Esatto.Umbraco.Backoffice.Build/lang/en.js"
    },
    {
      "type": "dashboard",
      "alias": "Esatto.Umbraco.Backoffice.Build.Dashboard",
      "name": "Build",
      "element": "/App_Plugins/Esatto.Umbraco.Backoffice.Build/build-dashboard.js",
      "elementName": "esatto-build-dashboard",
      "weight": -200,
      "meta": { "label": "Build", "pathname": "build" },
      "conditions": [{ "alias": "Umb.Condition.SectionAlias", "match": "Umb.Section.Content" }]
    }
  ]
}
